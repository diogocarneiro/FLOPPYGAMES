<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FloppyGames.Core\FloppyGames.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- catalog/ vive na raiz do repositório (irmão de samples/), não dentro deste projeto —
         LinkBase reorganiza o caminho de saída para "Catalog\..." em vez de reproduzir "..\..\catalog\...". -->
    <None Include="..\..\catalog\**\*" LinkBase="Catalog">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Resource Include="Assets\AppIcon.ico" />
    <None Include="..\..\tools\proxmark3\proxmark3.exe" LinkBase="Tools\proxmark3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AssemblyTitle>FloppyGames Label Studio</AssemblyTitle>
    <Description>Cria as disquetes/pens/cartões NFC do FloppyGames: escolhe o jogo, gera o GAME.INI e grava no suporte.</Description>
  </PropertyGroup>

</Project>
