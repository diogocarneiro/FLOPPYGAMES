<Window x:Class="FloppyGames.LabelStudio.LabelPrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Imprimir Label" Height="480" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <Border x:Name="LabelSurface" Width="300" Height="300" Background="White"
                BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Center">
            <Grid>
                <Image x:Name="LabelCoverImage" Stretch="UniformToFill" />
                <Border VerticalAlignment="Bottom" Background="#CC000000">
                    <TextBlock x:Name="LabelTitleText" Foreground="White" FontSize="16" FontWeight="Bold"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="6" />
                </Border>
            </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button x:Name="PrintButton" Width="120" Height="32" Click="OnPrintClicked" Margin="0,0,8,0" />
            <Button x:Name="ExportPngButton" Width="120" Height="32" Click="OnExportPngClicked" />
        </StackPanel>

        <TextBlock x:Name="StatusText" Foreground="Gray" Margin="0,12,0,0" TextWrapping="Wrap"
                   HorizontalAlignment="Center" />
    </StackPanel>
</Window>
