<Window x:Class="FloppyGames.LabelStudio.MainWindow"
        Icon="Assets/AppIcon.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="FloppyGames Label Studio" Height="1280" Width="1920" MinHeight="540" MinWidth="800"
        WindowStartupLocation="CenterScreen" SourceInitialized="OnSourceInitialized">
    <Window.Resources>
        <Style x:Key="StepHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#FF2A6DB0" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Passo 1: escolher a plataforma e o jogo -->
        <DockPanel Grid.Column="0">
            <TextBlock x:Name="Step1Header" DockPanel.Dock="Top" Style="{StaticResource StepHeader}" />

            <TextBlock x:Name="PlatformLabel" DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="PlatformCombo" DockPanel.Dock="Top" Margin="0,0,0,12"
                      DisplayMemberPath="DisplayName" SelectionChanged="OnPlatformChanged" />

            <TextBlock x:Name="InstalledGamesLabel" DockPanel.Dock="Top" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,8"
                     TextChanged="OnSearchTextChanged" />
            <TextBlock x:Name="GamesStatusText" DockPanel.Dock="Bottom" Foreground="Gray"
                       TextWrapping="Wrap" Margin="0,8,0,0" />
            <ListBox x:Name="GamesList" DisplayMemberPath="Name"
                     SelectionChanged="OnGameSelected">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <!-- Sem isto, leitores de ecrã e UI Automation ouvem/veem o ToString()
                             completo do registo InstalledSteamGame em vez do nome do jogo. -->
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>

        <!-- Coluna direita: passos 2 (detalhes), 3 (capa) e 4 (gravar) -->
        <DockPanel Grid.Column="2" x:Name="DetailsPanel" IsEnabled="False">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock x:Name="Step2Header" Style="{StaticResource StepHeader}" />

                <TextBlock x:Name="TitleFieldLabel" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="TitleBox" Margin="0,0,0,12" />

                <TextBlock x:Name="IdentifierLabel" Style="{StaticResource FieldLabel}" />
                <TextBlock x:Name="IdentifierText" Margin="0,0,0,12" FontFamily="Consolas" Foreground="#FF555555" />

                <TextBlock x:Name="ProcessFieldLabel" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="ProcessBox" Margin="0,0,0,12" />

                <TextBlock x:Name="DescriptionFieldLabel" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="DescriptionBox" Margin="0,0,0,12" Height="54"
                         TextWrapping="Wrap" AcceptsReturn="False" VerticalScrollBarVisibility="Auto" />

                <Expander x:Name="AdvancedOptionsExpander" Margin="0,0,0,16">
                    <StackPanel Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="WatchTimeoutFieldLabel" Margin="0,0,0,4" />
                                <TextBox x:Name="WatchTimeoutBox" Text="30" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="LaunchDelayFieldLabel" Margin="0,0,0,4" />
                                <TextBox x:Name="LaunchDelayBox" Text="2" />
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="GracefulShutdownBox" IsChecked="True" Margin="0,12,0,0" />
                    </StackPanel>
                </Expander>

                <TextBlock x:Name="Step3Header" Style="{StaticResource StepHeader}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <TextBlock x:Name="Step4Header" Style="{StaticResource StepHeader}" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton x:Name="TargetTypeDriveRadio" GroupName="TargetType"
                                 Margin="0,0,20,0" Checked="OnTargetTypeChanged" />
                    <RadioButton x:Name="TargetTypeNfcRadio" GroupName="TargetType" Checked="OnTargetTypeChanged" />
                </StackPanel>

                <StackPanel x:Name="DriveTargetPanel">
                    <TextBlock x:Name="TargetDriveLabel" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,12">
                        <Button x:Name="RefreshDrivesButton" DockPanel.Dock="Right" Width="80" Click="OnRefreshDrivesClicked" />
                        <ComboBox x:Name="DriveCombo" Margin="0,0,8,0" />
                    </DockPanel>
                </StackPanel>

                <StackPanel x:Name="NfcTargetPanel" Visibility="Collapsed">
                    <DockPanel Margin="0,0,0,8">
                        <Button x:Name="RefreshNfcReaderButton" DockPanel.Dock="Right" Width="80" Click="OnRefreshNfcReaderClicked" />
                        <TextBlock x:Name="NfcReaderStatusText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                    </DockPanel>
                    <TextBlock x:Name="NfcCardStatusText" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,12" />
                </StackPanel>

                <Button x:Name="WriteButton" Height="32" Click="OnWriteClicked" />
                <Button x:Name="PrintLabelButton" Height="32" Margin="0,8,0,0"
                        Click="OnPrintLabelClicked" />
                <TextBlock x:Name="WriteStatusText" Foreground="Gray" TextWrapping="Wrap" Margin="0,8,0,0" />
                <ProgressBar x:Name="WriteProgressBar" Height="10" Margin="0,6,0,0" Minimum="0" Maximum="100"
                             Visibility="Collapsed" Foreground="#FF39B35A" />
                <Button x:Name="FormatCardButton" Height="32" Margin="0,8,0,0" Visibility="Collapsed"
                        Foreground="#FFB00000" Click="OnFormatCardClicked" />
                <StackPanel x:Name="ProtectCardPanel" Visibility="Collapsed" Margin="0,8,0,0">
                    <CheckBox x:Name="ProtectCardCheckBox" Checked="OnProtectCardToggled" Unchecked="OnProtectCardToggled" />
                    <TextBlock x:Name="ProtectCardHintText" Foreground="Gray" TextWrapping="Wrap" FontSize="11" Margin="20,2,0,0" />
                </StackPanel>
                <Border x:Name="NfcBlockLogPanel" Visibility="Collapsed" Margin="0,8,0,0"
                        Background="#FF16161C" BorderBrush="#FF34343E" BorderThickness="1" CornerRadius="4">
                    <TextBox x:Name="NfcBlockLogBox" IsReadOnly="True" Height="130" Padding="8"
                             Background="Transparent" BorderThickness="0" Foreground="#FFB9E8C6"
                             FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </Border>
            </StackPanel>

            <Grid Margin="16,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border BorderBrush="#FFCCCCCC" BorderThickness="1" Background="#FFF3F3F3">
                    <Grid>
                        <Image x:Name="CoverImage" Stretch="Uniform" Margin="4" />
                        <TextBlock x:Name="NoCoverText" Foreground="Gray" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" />
                    </Grid>
                </Border>
                <Button x:Name="ChooseLocalCoverButton" Grid.Row="1" Margin="0,8,0,0" Click="OnChooseLocalCoverClicked" />
            </Grid>
        </DockPanel>
    </Grid>
</Window>
