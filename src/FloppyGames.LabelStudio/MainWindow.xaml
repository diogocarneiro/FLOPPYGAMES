<Window x:Class="FloppyGames.LabelStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="FloppyGames Label Studio" Height="640" Width="940" MinHeight="540" MinWidth="800">
    <Window.Resources>
        <Style x:Key="StepHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#FF2A6DB0" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Passo 1: escolher a plataforma e o jogo -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="1 · ESCOLHER JOGO" Style="{StaticResource StepHeader}" />

            <TextBlock DockPanel.Dock="Top" Text="Plataforma" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="PlatformCombo" DockPanel.Dock="Top" Margin="0,0,0,12"
                      SelectionChanged="OnPlatformChanged">
                <ComboBoxItem Content="Steam" />
                <ComboBoxItem Content="Epic Games" />
                <ComboBoxItem Content="GOG" />
            </ComboBox>

            <TextBlock DockPanel.Dock="Top" Text="Jogos instalados" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,8"
                     TextChanged="OnSearchTextChanged" />
            <TextBlock x:Name="GamesStatusText" DockPanel.Dock="Bottom" Foreground="Gray"
                       TextWrapping="Wrap" Margin="0,8,0,0" />
            <ListBox x:Name="GamesList" DisplayMemberPath="Name"
                     SelectionChanged="OnGameSelected">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <!-- Sem isto, leitores de ecrã e UI Automation ouvem/veem o ToString()
                             completo do registo InstalledSteamGame em vez do nome do jogo. -->
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>

        <!-- Coluna direita: passos 2 (detalhes), 3 (capa) e 4 (gravar) -->
        <DockPanel Grid.Column="2" x:Name="DetailsPanel" IsEnabled="False">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="2 · DETALHES" Style="{StaticResource StepHeader}" />

                <TextBlock Text="Título" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="TitleBox" Margin="0,0,0,12" />

                <TextBlock x:Name="IdentifierLabel" Text="Identificador" Style="{StaticResource FieldLabel}" />
                <TextBlock x:Name="IdentifierText" Margin="0,0,0,12" FontFamily="Consolas" Foreground="#FF555555" />

                <TextBlock Text="Processo (executável a vigiar)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="ProcessBox" Margin="0,0,0,12" />

                <TextBlock Text="Descrição (opcional, mostrada no ecrã de arranque)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="DescriptionBox" Margin="0,0,0,12" Height="54"
                         TextWrapping="Wrap" AcceptsReturn="False" VerticalScrollBarVisibility="Auto" />

                <Expander Header="Opções avançadas" Margin="0,0,0,16">
                    <StackPanel Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Timeout de arranque (s)" Margin="0,0,0,4" />
                                <TextBox x:Name="WatchTimeoutBox" Text="30" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Atraso de lançamento (s)" Margin="0,0,0,4" />
                                <TextBox x:Name="LaunchDelayBox" Text="2" />
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="GracefulShutdownBox" Content="Encerramento suave antes de forçar" IsChecked="True" Margin="0,12,0,0" />
                    </StackPanel>
                </Expander>

                <TextBlock Text="3 · CAPA" Style="{StaticResource StepHeader}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <TextBlock Text="4 · GRAVAR NO SUPORTE" Style="{StaticResource StepHeader}" />

                <TextBlock Text="Unidade destino" Style="{StaticResource FieldLabel}" />
                <DockPanel Margin="0,0,0,12">
                    <Button Content="Atualizar" DockPanel.Dock="Right" Width="80" Click="OnRefreshDrivesClicked" />
                    <ComboBox x:Name="DriveCombo" Margin="0,0,8,0" />
                </DockPanel>

                <Button x:Name="WriteButton" Content="Escrever para o suporte" Height="32" Click="OnWriteClicked" />
                <Button x:Name="PrintLabelButton" Content="Desenhar / imprimir label..." Height="32" Margin="0,8,0,0"
                        Click="OnPrintLabelClicked" />
                <TextBlock x:Name="WriteStatusText" Foreground="Gray" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>

            <Grid Margin="16,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border BorderBrush="#FFCCCCCC" BorderThickness="1" Background="#FFF3F3F3">
                    <Grid>
                        <Image x:Name="CoverImage" Stretch="Uniform" Margin="4" />
                        <TextBlock x:Name="NoCoverText" Foreground="Gray" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" />
                    </Grid>
                </Border>
                <Button Grid.Row="1" Content="Escolher imagem local..." Margin="0,8,0,0" Click="OnChooseLocalCoverClicked" />
            </Grid>
        </DockPanel>
    </Grid>
</Window>
