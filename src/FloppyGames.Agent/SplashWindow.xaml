<Window x:Class="FloppyGames.Agent.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FloppyGames"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        Background="#FF101014"
        Width="420" Height="280">
    <Border BorderBrush="#FF3A3A40" BorderThickness="1">
        <DockPanel Margin="24">
            <TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontSize="20" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" Margin="0,0,0,12" TextWrapping="Wrap" TextAlignment="Center" />
            <ProgressBar x:Name="ProgressIndicator" DockPanel.Dock="Bottom" IsIndeterminate="True" Height="6"
                         Foreground="#FF4CAF50" Background="#FF2A2A30" BorderThickness="0" Margin="0,12,0,0" />
            <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" FontSize="12" Foreground="#FFAAAAAA"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
            <Image x:Name="CoverImage" Stretch="Uniform" Margin="0,0,0,0" />
        </DockPanel>
    </Border>
</Window>
