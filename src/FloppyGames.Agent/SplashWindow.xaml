<Window x:Class="FloppyGames.Agent.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FloppyGames"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        Background="#FF0A0A0E"
        Width="1280" Height="720">
    <Grid>
        <!-- Camada 1: a própria capa do jogo, desfocada, a preencher o ecrã -->
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" Visibility="Collapsed">
            <Image.Effect>
                <BlurEffect Radius="38" />
            </Image.Effect>
        </Image>

        <!-- Vinheta: escurece as bordas para o texto se destacar sobre qualquer capa -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.32,0.5" RadiusX="1.0" RadiusY="1.0">
                    <GradientStop Color="#9E000006" Offset="0" />
                    <GradientStop Color="#F5000004" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Varrimento CRT subtil, no estilo dos ecrãs de arranque retro -->
        <Rectangle IsHitTestVisible="False" Opacity="0.05">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute" Stretch="None">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="Black">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,4,2" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Barra de destaque no topo -->
        <Rectangle Height="3" VerticalAlignment="Top" Fill="#FF39FF6A" />

        <!-- Conteúdo -->
        <Grid Margin="72,60,72,48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Capa, em cartão flutuante com sombra -->
            <Border x:Name="CoverCard" Grid.Column="0" VerticalAlignment="Center"
                    Background="#FF16161C" BorderBrush="#FF34343E" BorderThickness="1" CornerRadius="6"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="46" ShadowDepth="14" Opacity="0.65" Direction="270" />
                </Border.Effect>
                <Image x:Name="CoverImage" Stretch="Uniform" Margin="8" />
            </Border>

            <!-- Coluna direita: título, descrição, estatísticas, progresso -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="56" FontWeight="Bold" Foreground="White"
                           TextWrapping="Wrap" LineHeight="58">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="2" Opacity="0.85" />
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Selo do tipo de suporte, por baixo do nome do jogo -->
                <DockPanel Grid.Row="1" Margin="0,14,0,0">
                    <Canvas x:Name="FloppyIcon" DockPanel.Dock="Left" Width="30" Height="30" Visibility="Collapsed">
                        <Rectangle Width="30" Height="30" Fill="#FF2B2B2B" RadiusX="3" RadiusY="3" />
                        <Rectangle Canvas.Left="5" Canvas.Top="0" Width="15" Height="10" Fill="#FFC0C0C0" />
                        <Rectangle Canvas.Left="10" Canvas.Top="2" Width="4" Height="6" Fill="#FF2B2B2B" />
                        <Rectangle Canvas.Left="4" Canvas.Top="13" Width="22" Height="14" Fill="#FFE8E8E8" />
                        <Rectangle Canvas.Left="6" Canvas.Top="17" Width="16" Height="2" Fill="#FF9A9A9A" />
                        <Rectangle Canvas.Left="6" Canvas.Top="21" Width="16" Height="2" Fill="#FF9A9A9A" />
                    </Canvas>
                    <Canvas x:Name="UsbIcon" DockPanel.Dock="Left" Width="30" Height="30" Visibility="Collapsed">
                        <Rectangle Canvas.Left="10" Canvas.Top="1" Width="2" Height="4" Fill="#FFC0C0C0" />
                        <Rectangle Canvas.Left="15" Canvas.Top="1" Width="2" Height="4" Fill="#FFC0C0C0" />
                        <Rectangle Canvas.Left="7" Canvas.Top="4" Width="12" Height="7" Fill="#FFC0C0C0" />
                        <Rectangle Canvas.Left="4" Canvas.Top="10" Width="21" Height="18" Fill="#FF3A6EA5" RadiusX="4" RadiusY="4" />
                        <Rectangle Canvas.Left="8" Canvas.Top="15" Width="13" Height="4" Fill="#FFE8E8E8" />
                    </Canvas>
                    <TextBlock x:Name="MediaKindLabel" FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                               Foreground="#FF39FF6A" VerticalAlignment="Center" Margin="14,0,0,0" />
                </DockPanel>

                <TextBlock x:Name="DescriptionText" Grid.Row="2" FontSize="17" Foreground="#FFD2D2D8"
                           TextWrapping="Wrap" MaxHeight="82" Margin="0,20,0,0" Visibility="Collapsed" />

                <!-- Painel de estatísticas, no estilo de um terminal -->
                <Border Grid.Row="4" Background="#B3000000" BorderBrush="#FF2E2E38" BorderThickness="1" CornerRadius="4"
                        Padding="20,16" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock x:Name="SizeText" FontFamily="Consolas" FontSize="14" Foreground="#FFB9E8C6" Margin="0,0,0,6" />
                        <TextBlock x:Name="InstalledText" FontFamily="Consolas" FontSize="14" Foreground="#FFB9E8C6" Margin="0,0,0,6" />
                        <TextBlock x:Name="BuildText" FontFamily="Consolas" FontSize="14" Foreground="#FFB9E8C6" Margin="0,0,0,6" />
                        <TextBlock x:Name="UpdatedText" FontFamily="Consolas" FontSize="14" Foreground="#FFB9E8C6" Margin="0,0,0,6" />
                        <TextBlock x:Name="PlaytimeText" FontFamily="Consolas" FontSize="14" Foreground="#FFB9E8C6" Margin="0,0,0,6" />
                        <TextBlock x:Name="LastSessionText" FontFamily="Consolas" FontSize="14" Foreground="#FFB9E8C6" Margin="0,0,0,6" />
                        <TextBlock x:Name="AchievementsText" FontFamily="Consolas" FontSize="14" Foreground="#FFB9E8C6"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusText" Grid.Row="5" FontSize="14" Foreground="#FFAAAAB2" Margin="0,0,0,12" />

                <!-- Barra de progresso construída à mão para controlo total do visual -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="76" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ProgressTrack" Grid.Column="0" Background="#FF1C1C24" CornerRadius="8" Height="16"
                            ClipToBounds="True">
                        <Border x:Name="ProgressFill" Background="#FF39FF6A" CornerRadius="8" Width="0"
                                HorizontalAlignment="Left" />
                    </Border>
                    <TextBlock x:Name="ProgressPercentText" Grid.Column="1" FontFamily="Consolas" FontSize="15"
                               FontWeight="Bold" Foreground="#FF39FF6A" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Text="0%" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Marca, discreta, no canto -->
        <TextBlock Text="F L O P P Y G A M E S" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#FF4A4A54"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="72,0,0,20" />
        <TextBlock Text="© 2026 Diogo Carneiro. Tous droits réservés." FontFamily="Consolas" FontSize="12"
                   Foreground="#FF4A4A54" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,72,20" />
    </Grid>
</Window>
