<Window x:Class="FloppyGames.Agent.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FloppyGames"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        Background="#FF101014"
        Width="560" Height="420">
    <Border BorderBrush="#FF3A3A40" BorderThickness="1">
        <Grid>
            <!-- Wallpaper: a própria capa do jogo, desfocada e escurecida, a preencher a janela -->
            <Image x:Name="BackgroundImage" Stretch="UniformToFill" Visibility="Collapsed">
                <Image.Effect>
                    <BlurEffect Radius="22" />
                </Image.Effect>
            </Image>
            <Rectangle Fill="#CC0B0B10" />

            <!-- Conteúdo, por cima do wallpaper -->
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Cabeçalho: ícone do tipo de suporte + título -->
                <DockPanel Grid.Row="0">
                    <Canvas x:Name="FloppyIcon" DockPanel.Dock="Left" Width="28" Height="28" Margin="0,0,12,0"
                            VerticalAlignment="Center" Visibility="Collapsed">
                        <Rectangle Width="28" Height="28" Fill="#FF2B2B2B" RadiusX="2" RadiusY="2" />
                        <Rectangle Canvas.Left="5" Canvas.Top="0" Width="14" Height="9" Fill="#FFC0C0C0" />
                        <Rectangle Canvas.Left="9" Canvas.Top="2" Width="3" Height="5" Fill="#FF2B2B2B" />
                        <Rectangle Canvas.Left="3" Canvas.Top="12" Width="22" Height="13" Fill="#FFE8E8E8" />
                        <Rectangle Canvas.Left="5" Canvas.Top="15" Width="16" Height="2" Fill="#FF9A9A9A" />
                        <Rectangle Canvas.Left="5" Canvas.Top="19" Width="16" Height="2" Fill="#FF9A9A9A" />
                    </Canvas>
                    <Canvas x:Name="UsbIcon" DockPanel.Dock="Left" Width="28" Height="28" Margin="0,0,12,0"
                            VerticalAlignment="Center" Visibility="Collapsed">
                        <Rectangle Canvas.Left="9" Canvas.Top="1" Width="2" Height="4" Fill="#FFC0C0C0" />
                        <Rectangle Canvas.Left="14" Canvas.Top="1" Width="2" Height="4" Fill="#FFC0C0C0" />
                        <Rectangle Canvas.Left="7" Canvas.Top="3" Width="11" Height="7" Fill="#FFC0C0C0" />
                        <Rectangle Canvas.Left="4" Canvas.Top="9" Width="20" Height="18" Fill="#FF3A6EA5" RadiusX="3" RadiusY="3" />
                        <Rectangle Canvas.Left="8" Canvas.Top="14" Width="12" Height="4" Fill="#FFE8E8E8" />
                    </Canvas>
                    <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>

                <TextBlock x:Name="DescriptionText" Grid.Row="1" FontSize="12" Foreground="#FFD8D8D8"
                           TextWrapping="Wrap" MaxHeight="54" Margin="0,10,0,0" Visibility="Collapsed" />

                <Image x:Name="CoverImage" Grid.Row="2" Stretch="Uniform" HorizontalAlignment="Left"
                       MaxHeight="150" Margin="0,12,0,12" Visibility="Collapsed" />

                <StackPanel Grid.Row="3" Orientation="Horizontal">
                    <TextBlock x:Name="SizeText" FontFamily="Consolas" FontSize="11" Foreground="#FF9AD1FF" Margin="0,0,18,0" />
                    <TextBlock x:Name="Crc32Text" FontFamily="Consolas" FontSize="11" Foreground="#FF9AD1FF" Margin="0,0,18,0" />
                    <TextBlock x:Name="InstalledText" FontFamily="Consolas" FontSize="11" Foreground="#FF9AD1FF" />
                </StackPanel>

                <TextBlock x:Name="StatusText" Grid.Row="4" FontSize="12" Foreground="#FFAAAAAA"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />

                <ProgressBar x:Name="ProgressIndicator" Grid.Row="5" IsIndeterminate="True" Height="8"
                             Minimum="0" Maximum="100"
                             Foreground="#FF4CAF50" Background="#FF2A2A30" BorderThickness="0" Margin="0,10,0,0" />
            </Grid>
        </Grid>
    </Border>
</Window>
