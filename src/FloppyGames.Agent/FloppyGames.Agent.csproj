<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FloppyGames.Core\FloppyGames.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\floppy-motor.wav" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\AppIcon.ico" />
    <!-- O cliente Proxmark3 (compilado com MSYS2) precisa destes DLLs ao lado — sem eles falha com
         "DLL not found" em qualquer PC sem MSYS2 no PATH. Ver tools/proxmark3/NOTICE.md. -->
    <None Include="..\..\tools\proxmark3\proxmark3.exe;..\..\tools\proxmark3\*.dll" LinkBase="Tools\proxmark3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AssemblyTitle>FloppyGames Agent</AssemblyTitle>
    <Description>Liga uma disquete física à tua biblioteca Steam/Epic/GOG: insere o suporte, o jogo arranca; remove-o, o jogo fecha-se.</Description>
  </PropertyGroup>

</Project>
