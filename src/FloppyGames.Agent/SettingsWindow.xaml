<Window x:Class="FloppyGames.Agent.SettingsWindow"
        Icon="Assets/AppIcon.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Definições — FloppyGames"
        Height="800" Width="600"
        WindowStartupLocation="CenterScreen" SourceInitialized="OnSourceInitialized"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">
        <CheckBox x:Name="AutostartCheckBox"
                  Checked="OnAutostartToggled" Unchecked="OnAutostartToggled" Margin="0,0,0,20" />

        <CheckBox x:Name="FloppySoundCheckBox"
                  Checked="OnFloppySoundToggled" Unchecked="OnFloppySoundToggled" Margin="0,0,0,20" />

        <CheckBox x:Name="CrtEffectCheckBox"
                  Checked="OnCrtEffectToggled" Unchecked="OnCrtEffectToggled" Margin="0,0,0,20" />

        <TextBlock x:Name="LanguageLabelText" FontWeight="Bold" Margin="0,0,0,4" />
        <ComboBox x:Name="LanguageCombo" Margin="0,0,0,4" SelectionChanged="OnLanguageChanged" />
        <TextBlock x:Name="LanguageRestartNoteText" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,20" />

        <TextBlock x:Name="PlatformsLabelText" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock x:Name="PlatformsDescriptionText" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8" />
        <CheckBox x:Name="SteamEnabledCheckBox" Content="Steam" Margin="0,0,0,4"
                  Checked="OnSteamEnabledToggled" Unchecked="OnSteamEnabledToggled" />
        <CheckBox x:Name="EpicEnabledCheckBox" Content="Epic Games" Margin="0,0,0,4"
                  Checked="OnEpicEnabledToggled" Unchecked="OnEpicEnabledToggled" />
        <CheckBox x:Name="GogEnabledCheckBox" Content="GOG" Margin="0,0,0,20"
                  Checked="OnGogEnabledToggled" Unchecked="OnGogEnabledToggled" />

        <CheckBox x:Name="NfcEnabledCheckBox"
                  Checked="OnNfcEnabledToggled" Unchecked="OnNfcEnabledToggled" Margin="0,0,0,4" />
        <TextBlock x:Name="NfcDescriptionText" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock x:Name="NfcCardPasswordLabelText" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock x:Name="NfcCardPasswordDescriptionText" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8" />
        <DockPanel Margin="0,0,0,20">
            <Button x:Name="SaveNfcCardPasswordButton" DockPanel.Dock="Right" Width="70" Click="OnSaveNfcCardPasswordClicked" />
            <PasswordBox x:Name="NfcCardPasswordBox" Margin="0,0,8,0" />
        </DockPanel>

        <TextBlock x:Name="LogsFolderLabelText" FontWeight="Bold" Margin="0,0,0,4" />
        <DockPanel Margin="0,0,0,20">
            <Button x:Name="OpenLogsButton" DockPanel.Dock="Right" Width="70" Click="OnOpenLogsClicked" />
            <TextBlock x:Name="LogsPathText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Margin="0,0,8,0" />
        </DockPanel>

        <TextBlock x:Name="SteamApiKeyLabelText" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock x:Name="SteamApiKeyDescriptionText"
                   Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8" />
        <DockPanel Margin="0,0,0,8">
            <Button x:Name="SaveApiKeyButton" DockPanel.Dock="Right" Width="70" Click="OnSaveApiKeyClicked" />
            <TextBox x:Name="SteamWebApiKeyBox" Margin="0,0,8,0" />
        </DockPanel>
        <TextBlock Margin="0,0,0,16">
            <Hyperlink x:Name="ApiKeyLink" NavigateUri="https://steamcommunity.com/dev/apikey" RequestNavigate="OnApiKeyLinkClicked" />
        </TextBlock>

        <TextBlock x:Name="StatusText" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,20" />

        <Rectangle Height="1" Fill="#FFDDDDDD" Margin="0,0,0,16" />

        <TextBlock x:Name="UpdatesLabelText" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock x:Name="UpdatesDescriptionText" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8" />
        <CheckBox x:Name="CheckForUpdatesCheckBox" Margin="0,0,0,8"
                  Checked="OnCheckForUpdatesToggled" Unchecked="OnCheckForUpdatesToggled" />
        <DockPanel Margin="0,0,0,8">
            <Button x:Name="CheckForUpdatesNowButton" DockPanel.Dock="Right" Width="110" Click="OnCheckForUpdatesNowClicked" />
            <TextBlock x:Name="UpdateStatusText" VerticalAlignment="Center" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,8,0" />
        </DockPanel>
        <Button x:Name="InstallUpdateButton" HorizontalAlignment="Left" Padding="10,4" Visibility="Collapsed"
                Margin="0,0,0,20" Click="OnInstallUpdateClicked" />

        <Rectangle Height="1" Fill="#FFDDDDDD" Margin="0,0,0,16" />

        <TextBlock x:Name="AboutLabelText" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock x:Name="AboutDescriptionText" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock x:Name="AboutCreatedByText" Margin="0,0,0,2" />
        <TextBlock Margin="0,0,0,8">
            <Hyperlink x:Name="AboutSiteLink" NavigateUri="https://www.diogocarneiro.fr" RequestNavigate="OnApiKeyLinkClicked">https://www.diogocarneiro.fr</Hyperlink>
        </TextBlock>
        <TextBlock Text="© 2026 Diogo Carneiro. Tous droits réservés." Foreground="Gray" FontSize="11" />
    </StackPanel>
    </ScrollViewer>
</Window>
