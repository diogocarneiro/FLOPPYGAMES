<Window x:Class="FloppyGames.Agent.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Definições — FloppyGames"
        Height="240" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="20">
        <CheckBox x:Name="AutostartCheckBox" Content="Iniciar o FloppyGames Agent com o Windows"
                  Checked="OnAutostartToggled" Unchecked="OnAutostartToggled" Margin="0,0,0,20" />

        <TextBlock Text="Pasta de logs" FontWeight="Bold" Margin="0,0,0,4" />
        <DockPanel Margin="0,0,0,16">
            <Button Content="Abrir" DockPanel.Dock="Right" Width="70" Click="OnOpenLogsClicked" />
            <TextBlock x:Name="LogsPathText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Margin="0,0,8,0" />
        </DockPanel>

        <TextBlock x:Name="StatusText" Foreground="Gray" TextWrapping="Wrap" />
    </StackPanel>
</Window>
