<Window x:Class="FloppyGames.Agent.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Definições — FloppyGames"
        Height="480" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="20">
        <CheckBox x:Name="AutostartCheckBox"
                  Checked="OnAutostartToggled" Unchecked="OnAutostartToggled" Margin="0,0,0,20" />

        <CheckBox x:Name="FloppySoundCheckBox"
                  Checked="OnFloppySoundToggled" Unchecked="OnFloppySoundToggled" Margin="0,0,0,20" />

        <CheckBox x:Name="CrtEffectCheckBox"
                  Checked="OnCrtEffectToggled" Unchecked="OnCrtEffectToggled" Margin="0,0,0,20" />

        <TextBlock x:Name="LanguageLabelText" FontWeight="Bold" Margin="0,0,0,4" />
        <ComboBox x:Name="LanguageCombo" Margin="0,0,0,4" SelectionChanged="OnLanguageChanged" />
        <TextBlock x:Name="LanguageRestartNoteText" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,20" />

        <TextBlock x:Name="LogsFolderLabelText" FontWeight="Bold" Margin="0,0,0,4" />
        <DockPanel Margin="0,0,0,20">
            <Button x:Name="OpenLogsButton" DockPanel.Dock="Right" Width="70" Click="OnOpenLogsClicked" />
            <TextBlock x:Name="LogsPathText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Margin="0,0,8,0" />
        </DockPanel>

        <TextBlock x:Name="SteamApiKeyLabelText" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock x:Name="SteamApiKeyDescriptionText"
                   Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8" />
        <DockPanel Margin="0,0,0,8">
            <Button x:Name="SaveApiKeyButton" DockPanel.Dock="Right" Width="70" Click="OnSaveApiKeyClicked" />
            <TextBox x:Name="SteamWebApiKeyBox" Margin="0,0,8,0" />
        </DockPanel>
        <TextBlock Margin="0,0,0,16">
            <Hyperlink x:Name="ApiKeyLink" NavigateUri="https://steamcommunity.com/dev/apikey" RequestNavigate="OnApiKeyLinkClicked" />
        </TextBlock>

        <TextBlock x:Name="StatusText" Foreground="Gray" TextWrapping="Wrap" />
    </StackPanel>
</Window>
