<Window x:Class="FloppyGames.Agent.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Definições — FloppyGames"
        Height="380" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="20">
        <CheckBox x:Name="AutostartCheckBox" Content="Iniciar o FloppyGames Agent com o Windows"
                  Checked="OnAutostartToggled" Unchecked="OnAutostartToggled" Margin="0,0,0,20" />

        <CheckBox x:Name="FloppySoundCheckBox" Content="Tocar o som de motor ao inserir uma disquete física"
                  Checked="OnFloppySoundToggled" Unchecked="OnFloppySoundToggled" Margin="0,0,0,20" />

        <TextBlock Text="Pasta de logs" FontWeight="Bold" Margin="0,0,0,4" />
        <DockPanel Margin="0,0,0,20">
            <Button Content="Abrir" DockPanel.Dock="Right" Width="70" Click="OnOpenLogsClicked" />
            <TextBlock x:Name="LogsPathText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Margin="0,0,8,0" />
        </DockPanel>

        <TextBlock Text="Chave da Steam Web API (opcional)" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Text="Só é usada para mostrar o número de conquistas no ecrã de arranque. Sem chave, essa linha simplesmente não aparece — o resto do FloppyGames continua 100% offline."
                   Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8" />
        <DockPanel Margin="0,0,0,8">
            <Button Content="Guardar" DockPanel.Dock="Right" Width="70" Click="OnSaveApiKeyClicked" />
            <TextBox x:Name="SteamWebApiKeyBox" Margin="0,0,8,0" />
        </DockPanel>
        <TextBlock Margin="0,0,0,16">
            <Hyperlink NavigateUri="https://steamcommunity.com/dev/apikey" RequestNavigate="OnApiKeyLinkClicked">
                Obter uma chave grátis em steamcommunity.com/dev/apikey
            </Hyperlink>
        </TextBlock>

        <TextBlock x:Name="StatusText" Foreground="Gray" TextWrapping="Wrap" />
    </StackPanel>
</Window>
