<Window x:Class="FloppyGames.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FloppyGames.Agent"
        mc:Ignorable="d"
        Title="FloppyGames Agent" Height="450" Width="640">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="FloppyGames Agent" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="A vigiar unidades amovíveis para GAME.INI — insere ou remove um suporte para ver o estado aqui."
                       TextWrapping="Wrap" Foreground="Gray" Margin="0,4,0,0" />
        </StackPanel>
        <ListBox ItemsSource="{Binding StatusLog}" FontFamily="Consolas" />
    </DockPanel>
</Window>
