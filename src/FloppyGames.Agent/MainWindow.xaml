<Window x:Class="FloppyGames.Agent.MainWindow"
        Icon="Assets/AppIcon.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FloppyGames.Agent"
        mc:Ignorable="d"
        Title="FloppyGames Agent" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen" SourceInitialized="OnSourceInitialized">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="FloppyGames Agent" FontSize="20" FontWeight="Bold" />
            <TextBlock x:Name="SubtitleText" TextWrapping="Wrap" Foreground="Gray" Margin="0,4,0,0" />
        </StackPanel>
        <TextBlock x:Name="FooterText" DockPanel.Dock="Bottom" Foreground="Gray" FontSize="11"
                   HorizontalAlignment="Center" Margin="0,8,0,0" />
        <ListBox ItemsSource="{Binding StatusLog}" FontFamily="Consolas" />
    </DockPanel>
</Window>
